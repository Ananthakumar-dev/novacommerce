    {
      "type": "java",
      "name": "OrderServiceApplication",
      "request": "launch",
      "mainClass": "com.novacommerce.order_service.OrderServiceApplication",
      "projectName": "order-service"
    },
    {
      "type": "java",
      "name": "ProductServiceApplication",
      "request": "launch",
      "mainClass": "com.novacommerce.product.ProductServiceApplication",
      "projectName": "product-service"
    },
    {
      "type": "java",
      "name": "ApiGatewayApplication",
      "request": "launch",
      "mainClass": "com.novacommerce.gateway.ApiGatewayApplication",
      "projectName": "api-gateway"
    },
    {
      "type": "java",
      "name": "Spring Boot-AuthServiceApplication<auth-service>",
